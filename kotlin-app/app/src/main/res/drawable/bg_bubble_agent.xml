<?xml version="1.0" encoding="utf-8"?>
<!-- Burbuja del asistente: relleno rosa pálido de acento, sin borde ni barra
     lateral, esquina inferior-izquierda casi recta ("cola") como en las apps
     de mensajería actuales. -->
