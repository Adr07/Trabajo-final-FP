<?xml version="1.0" encoding="utf-8"?>
<!--
    Permite tráfico HTTP en texto plano solo hacia el host especial del
    emulador (10.0.2.2 -> localhost de la máquina anfitriona), donde corre
    el agente en desarrollo. No afecta a ningún otro dominio.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
