# LLM — cualquier proveedor compatible con la API de OpenAI.
# Para OpenAI real: deja LLM_BASE_URL vacío.
# Para Gemini (u otro proveedor compatible): pon su endpoint OpenAI-compatible.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Odoo — usuario de integración dedicado, configurado desde el módulo Odoo
# (odoo/addons/assistant_agent). No usar un usuario humano ni su contraseña.
ODOO_URL=http://localhost:8069
ODOO_DB=odoo_test
ODOO_USERNAME=
ODOO_API_KEY=
